    "leading_h_rules": {
      "description": "ห leading before low-class sonorants changes class to high",
      "pattern": "ห + [ง น ม ย ร ล ว] → high class onset",
      "examples": {
        "หนา": "high class (rising tone)",
        "หมา": "high class (rising tone)",
        "หลาย": "high class (rising tone)"
      },
      "note": "ห is silent in pronunciation but affects tone"
    },
    "leading_o_rules": {
      "description": "อ leading before low-class consonants changes class to mid",
      "pattern": "อ + low_consonant → mid class onset",
      "examples": {
        "อย่า": "mid class tone behavior",
        "อยาก": "mid class tone behavior"
      },
      "note": "อ is silent in pronunciation but affects tone"
    }
  },
  "special_cases": {
