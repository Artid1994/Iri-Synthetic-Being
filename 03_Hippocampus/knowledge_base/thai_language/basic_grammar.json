  "grammatical_roles": {
    "subject": {
      "definition": "Agent or topic of sentence",
      "position": "sentence-initial",
      "note": "KNOWN: Typically first element in main clause"
    },
    "verb": {
      "definition": "Action or state",
      "position": "after subject",
      "note": "KNOWN: Core predicate"
    },
    "object": {
      "definition": "Patient or theme",
      "position": "after verb",
      "note": "KNOWN: Direct object follows verb"
    },
    "adjective": {
      "definition": "Modifier or stative predicate",
      "position": "after noun or as main predicate",
      "note": "KNOWN: Functions as both modifier and verb"
    }
  },
  "limitations": {
    "note": "This is a MINIMAL foundation dataset for initial sentence understanding.",
