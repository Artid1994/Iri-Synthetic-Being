      "example": "ไม่ ดี",
      "meaning": "not good",
      "note": "KNOWN: Standard negation marker"
    },
    {
      "particle": "หรือ",
      "function": "yes-no question",
      "position": "sentence-final",
      "example": "ดี หรือ",
