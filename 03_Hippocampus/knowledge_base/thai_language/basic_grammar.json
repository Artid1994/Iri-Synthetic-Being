      "note": "AMBIGUOUS: Question particles vary; หรือ is one option"
    },
    {
      "particle": "ไหม",
      "function": "yes-no question",
      "position": "sentence-final",
      "example": "ดี ไหม",
      "meaning": "Is it good?",
      "note": "KNOWN: Common polite question particle"
    }
  ],
