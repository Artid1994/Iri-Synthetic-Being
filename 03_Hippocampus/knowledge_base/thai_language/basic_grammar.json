      "structure": "Subject + Verb + Object",
      "example_thai": "คน กิน น้ำ",
      "example_gloss": "person eat water",
      "example_meaning": "The person drinks water.",
      "note": "KNOWN: Basic transitive pattern, SVO order"
    },
    {
      "pattern": "S-Adj",
      "structure": "Subject + Adjective (stative verb)",
      "example_thai": "คน ดี",
      "example_gloss": "person good",
      "example_meaning": "The person is good.",
      "note": "KNOWN: Thai adjectives function as stative verbs"
    },
    {
      "pattern": "N-Adj",
      "structure": "Noun + Adjective",
      "example_thai": "บ้าน ใหญ่",
      "example_gloss": "house big",
      "example_meaning": "big house",
      "note": "KNOWN: Adjectives follow nouns"
    }
  ],
  "word_order": {
    "basic_order": "SVO",
